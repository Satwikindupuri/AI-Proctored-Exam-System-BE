# .gitignore for Node.js / Express project

# Node modules
node_modules/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
logs
*.log

# Runtime data
tmp/
temp/
pids/
*.pid

# Coverage and reports
coverage/
.nyc_output/

# Build output
dist/
build/

# Environment variables
.env
.env.*
.env.local

# Uploaded files (do not commit large user uploads)
uploads/

# Databases
*.sqlite
*.sqlite3
*.db

# OS files
.DS_Store
Thumbs.db
desktop.ini

# IDEs and editors
.vscode/
.idea/
*.sublime-workspace
*.sublime-project

# Misc
.DS_Store
